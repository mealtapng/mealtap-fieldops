# =============================================================================
# Mealtap Field Ops — Environment Variables
#
# HOW TO USE THIS FILE:
#   1. Copy this file to .env.local in the project root
#   2. Replace every placeholder value with your real credentials
#   3. NEVER commit .env.local — it is gitignored
#
# This file (.env.local.example) IS committed to git and acts as documentation.
# Keep it up to date whenever you add a new environment variable.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
# -----------------------------------------------------------------------------

# Your Supabase project URL. Safe to expose — it's in your JS bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (publishable) key. Safe to expose — RLS enforces access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# !! SECURITY CRITICAL — SERVER-SIDE ONLY !!
# The service role key bypasses ALL Row Level Security policies.
# - NEVER prefix this with NEXT_PUBLIC_
# - NEVER import lib/env.ts (which holds this) in a client component
# - NEVER use this in src/app/ components or any file marked 'use client'
# - Only use it in Route Handlers (src/app/api/) and Server Actions for admin ops
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# -----------------------------------------------------------------------------
# Mapbox — https://account.mapbox.com/access-tokens/
# -----------------------------------------------------------------------------

# Mapbox public access token. Safe to expose — scope it to your domain in production.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Canonical app URL. Used for absolute URLs in emails, redirects, etc.
# Development : http://localhost:3000
# Production  : https://field.mealtap.ng
NEXT_PUBLIC_APP_URL=http://localhost:3000
